{
  "opencollection": "1.0.0",
  "info": {
    "name": "PrintNode Account Clients API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Clients",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List the available PrintNode Client download versions.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.printnode.com/download/clients"
          },
          "docs": "List the available PrintNode Client download versions."
        }
      ]
    }
  ],
  "bundled": true
}